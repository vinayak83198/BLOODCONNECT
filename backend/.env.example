# Copy these values into your shell or hosting provider's environment settings.
# Never commit real credentials or this file with real values.

# Email links must point to the public frontend URL after deployment.
FRONTEND_BASE_URL=http://127.0.0.1:5500

# SMTP configuration (Gmail example: use a Google App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# Use a long random secret in production. Do not use the development default.
BLOODCONNECT_SECRET_KEY=replace-with-a-long-random-secret

# Optional Telegram bot integration
TELEGRAM_BOT_TOKEN=replace-with-your-rotated-bot-token
